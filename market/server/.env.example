# Copy to .env on the server. Values never enter the repository.
MARKET_HOST_PUBLIC_ORIGIN=https://npm.tokensapi.ai
MARKET_ADMIN_TOKEN=
MARKET_HMAC_SECRET=
MARKET_KEY_ENCRYPTION_SECRET=
MARKET_ORGANIZATIONS_BASE_URL=https://tokensapi.ai
MARKET_ORGANIZATIONS_TOKEN=
MARKET_PRIVATE_REGISTRY_ENABLED=true
MARKET_PRIVATE_REGISTRY_URL=https://npm.tokensapi.ai/
MARKET_PRIVATE_REGISTRY_AUTH_SCHEME=basic
MARKET_PRIVATE_REGISTRY_TOKEN=
# 归档转发的响应头超时（毫秒，1000-120000，默认 20000）。包体由流式转发，
# 这个值只管“多久拿不到响应头就算不可用”，与包大小无关。
MARKET_PRIVATE_REGISTRY_TARBALL_TIMEOUT_MS=20000
# 已验证归档的磁盘缓存上限（字节，默认 2 GiB；设 0 关闭缓存）。
MARKET_TARBALL_CACHE_MAX_BYTES=2147483648
