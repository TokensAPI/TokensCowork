{
  "name": "tokens-cowork",
  "version": "0.5.2",
  "private": true,
  "description": "Pinned superproject for assembling and releasing TokensCowork Desktop",
  "repository": "https://github.com/TokensAPI/TokensCowork.git",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "product:check": "node build/pipeline/repo-layout-verify.mjs",
    "test:build": "node build/pipeline/build-verify.mjs",
    "product:plan": "node build/build.mjs win --plan",
    "product:overlays": "node build/pipeline/overlay-review.mjs",
    "market:check": "node build/modules/market/market-catalog-verify.mjs",
    "product:prepare": "node build/pipeline/plugin-artifacts-fetch.mjs && node build/pipeline/staging-prepare.mjs",
    "product:refresh-lock": "node build/pipeline/product-lock-refresh.mjs",
    "product:version-check": "bash scripts/set-version.sh --check",
    "test:release-notes": "node --test scripts/validate-release-notes.test.mjs",
    "product:check-desktop": "node build/build.mjs check",
    "product:dist:win": "node build/build.mjs win",
    "product:dist:mac": "node build/build.mjs mac",
    "product:dist:mac-unsigned": "node build/build.mjs mac-unsigned",
    "product:dist:mac:auto": "node build/pipeline/macos-build.mjs",
    "test:mac-signing": "node --test build/modules/platform/mac-signing-resolve.test.mjs",
    "test:uninstall": "node --test scripts/uninstall-windows.test.mjs",
    "product:uninstall:win": "node scripts/uninstall-windows.mjs"
  }
}
