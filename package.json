{
  "name": "tokens-tokensharness-code",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned superproject for assembling and releasing a DSH Desktop product",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "product:check": "node build/verify-layout.mjs",
    "product:prepare": "node build/prepare-desktop.mjs",
    "product:refresh-lock": "node build/refresh-lock.mjs",
    "product:version-check": "bash scripts/set-version.sh --check",
    "test:release-notes": "node --test scripts/validate-release-notes.test.mjs",
    "product:check-desktop": "node build/build-desktop.mjs check",
    "product:dist:win": "node build/build-desktop.mjs win",
    "product:dist:mac": "node build/build-desktop.mjs mac",
    "product:dist:mac-unsigned": "node build/build-desktop.mjs mac-unsigned"
  }
}
