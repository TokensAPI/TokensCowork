{
  "name": "tokens-cowork",
  "version": "0.4.8",
  "private": true,
  "description": "Pinned superproject for assembling and releasing TokensCowork Desktop",
  "repository": "https://github.com/TokensAPI/TokensCowork.git",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "product:check": "node build/verify/repo-layout-verify.mjs",
    "market:check": "node build/verify/market-catalog-verify.mjs",
    "product:prepare": "node build/steps/plugin-artifacts-fetch.mjs && node build/steps/staging-prepare.mjs",
    "product:refresh-lock": "node build/steps/product-lock-refresh.mjs",
    "product:version-check": "bash scripts/set-version.sh --check",
    "test:release-notes": "node --test scripts/validate-release-notes.test.mjs",
    "product:check-desktop": "node build/desktop-build.mjs check",
    "product:dist:win": "node build/desktop-build.mjs win",
    "product:dist:mac": "node build/desktop-build.mjs mac",
    "product:dist:mac-unsigned": "node build/desktop-build.mjs mac-unsigned",
    "product:dist:mac:auto": "node build/steps/macos-build.mjs",
    "test:mac-signing": "node --test build/steps/mac-signing-resolve.test.mjs",
    "test:uninstall": "node --test scripts/uninstall-windows.test.mjs",
    "product:uninstall:win": "node scripts/uninstall-windows.mjs"
  }
}
