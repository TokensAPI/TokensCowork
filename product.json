{
  "schemaVersion": 1,
  "product": {
    "name": "TokensHarness",
    "appId": "com.tokensapi.tokensharness",
    "version": "0.3.10"
  },
  "desktop": {
    "path": "desktop",
    "repository": "https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "commit": "d457d790295e727bbb1fc20e398da602f521fd64",
    "deepseekHarnessCommit": "141eb6fef83422698aef7a981029e843e8161534"
  },
  "plugins": [
    {
      "id": "tokens-version-updates",
      "displayName": "TokensHarness 更新",
      "description": "从 TokensHarness GitHub Release 检查并下载产品更新，替代官方 DSH 更新入口。",
      "path": "plugins/tokens_DshVersionUpdates_code",
      "repository": "https://github.com/sobermh/tokens_DshVersionUpdates_code.git",
      "commit": "90251f448dbd302e68c464d7528848ada7a77e1a",
      "package": "@tokens/dsh-version-updates",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.8",
        "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "tokens-feishu-connect",
      "displayName": "飞书连接",
      "description": "连接飞书或 Lark，支持应用创建、个人 OAuth、文档与消息工具。",
      "path": "plugins/tokens_DshFeishuConnect_code",
      "repository": "https://github.com/sobermh/tokens_DshFeishuConnect_code.git",
      "commit": "d764386f768b65cac5efa9a2b2a8b6b69599d202",
      "package": "@tokens/dsh-feishu-connect",
      "version": "0.2.1",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeBuild": {
        "script": "build",
        "outputs": [
          "dist/index.js"
        ]
      },
      "runtimeDependencies": {
        "@deepseek-ai/dsh-commands": "0.1.0-rc.8",
        "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
        "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "tokens-model-manager",
      "displayName": "TokensAPI 模型",
      "description": "统一管理 TokensAPI API Key、主模型与文本视觉桥接，并同步当前会话模型。",
      "path": "plugins/tokens_DshModelManager_code",
      "repository": "https://github.com/TokensAPI/tokens_DshModelManager_code.git",
      "commit": "d86d2f83fdbd66ace8cb713ffcf4d7a137a1d3c2",
      "package": "@tokens/dsh-model-manager",
      "version": "0.2.2",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-at-file",
      "displayName": "本地文件引用",
      "description": "支持选择或拖入本地文件，并将文件路径交给 Harness 使用当前会话工具读取。",
      "path": "plugins/tokens_DshAtFile_code",
      "repository": "https://github.com/TokensAPI/tokens_DshAtFile_code.git",
      "commit": "f068fb9a043188c92f9868f1d8643cee486cd123",
      "package": "@tokens/dsh-at-file",
      "version": "0.1.1",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-dsh-web-search",
      "displayName": "联网搜索",
      "description": "为原生 web_search 提供免额外 API Key 的多引擎联网搜索与自动回退。",
      "path": "plugins/tokens_DshWebSearch_code",
      "repository": "https://github.com/sobermh/tokens_DshWebSearch_code.git",
      "commit": "277a7a4fb7da36131487efb53b207bbe1afab5a2",
      "package": "tokens-dsh-web-search",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    }
  ]
}
