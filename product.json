{
  "schemaVersion": 1,
  "product": {
    "name": "TokensCowork",
    "appId": "com.tokensapi.tokenscowork",
    "windowsInstallerGuid": "c934e938-5a76-57ee-b6d0-af6fb8157615",
    "repository": "TokensAPI/TokensCowork",
    "legacyNames": [
      "TokensHarness"
    ],
    "version": "0.7.4"
  },
  "desktop": {
    "path": "desktop",
    "repository": "https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "commit": "6a63b9730b82cf4e858b9a11ac9783da9a5a0c3a",
    "deepseekHarnessCommit": "687f282e8625c6b8d11ff58211a90524be2e4317",
    "runtimeVersion": "0.2.1-rc.2"
  },
  "plugins": [
    {
      "id": "tokens-version-updates",
      "displayName": "TokensCowork 更新",
      "description": "从 TokensCowork GitHub Release 检查并下载产品更新，替代官方 DSH 更新入口。",
      "path": "plugins/tokens_DshVersionUpdates_code",
      "repository": "https://github.com/sobermh/tokens_DshVersionUpdates_code.git",
      "commit": "665914729b211230f1c3dedb03287b68bd4ffd14",
      "package": "@tokens/dsh-version-updates",
      "version": "0.1.3",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
        "@deepseek-ai/schemastery": "^3.18.5"
      }
    },
    {
      "id": "dsh-tokensapi-ui",
      "displayName": "Tokens Cowork UI",
      "description": "为 Tokens Cowork 提供品牌视觉、主题皮肤、技能入口和侧栏界面扩展。",
      "path": "plugins/dsh-tokensapi-ui",
      "repository": "https://github.com/TokensAPI/dsh-tokensapi-ui.git",
      "commit": "26c4fe0c9a29b0ad0be36504ea94d630998777d2",
      "package": "dsh-tokensapi-ui",
      "version": "0.2.24",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "artifact": {
        "type": "npm-tgz",
        "url": "https://github.com/TokensAPI/dsh-tokensapi-ui/releases/download/v0.2.24/dsh-tokensapi-ui-0.2.24.tgz",
        "sha256": "1df2a00f3a136bcf392d8c489a15b689e0861f4f07d98385f14e068439b35ee1"
      },
      "runtimeDependencies": {}
    },
    {
      "id": "tokens-login",
      "displayName": "TokensAPI 账户",
      "description": "用自己的浏览器登录 TokensAPI 账户，并自动配置账户下的 API Key 供模型插件共用。",
      "path": "plugins/tokens_DshLogin_code",
      "repository": "https://github.com/TokensAPI/tokens_DshLogin_code.git",
      "commit": "e6f6bcae0181212443b08ede35629d558a6231ff",
      "package": "@tokensapi/dsh-login",
      "version": "0.1.12",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-model-manager",
      "displayName": "TokensAPI 模型",
      "description": "统一管理 TokensAPI API Key、主模型与文本视觉桥接，并同步当前会话模型。",
      "path": "plugins/tokens_DshModelManager_code",
      "repository": "https://github.com/TokensAPI/tokens_DshModelManager_code.git",
      "commit": "0d6c1e544e54ef756b85a8c0901f010c94f8d23c",
      "package": "@tokens/dsh-model-manager",
      "version": "0.2.27",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-dsh-web-search",
      "displayName": "联网搜索",
      "description": "为原生 web_search 提供免额外 API Key 的多引擎联网搜索与自动回退。",
      "path": "plugins/tokens_DshWebSearch_code",
      "repository": "https://github.com/sobermh/tokens_DshWebSearch_code.git",
      "commit": "f8b8fdcd95ab79a3f9f215475e6d0ff71baa186d",
      "package": "tokens-dsh-web-search",
      "version": "0.2.3",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/schemastery": "^3.18.5"
      }
    },
    {
      "id": "tokens-loop-guard",
      "displayName": "循环护栏",
      "description": "检测工具的精确重复与近似重复调用,先提醒后硬阻断,替代上游 repeat-tool-reminder。",
      "path": "plugins/tokens_DshLoopGuard_code",
      "repository": "https://github.com/TokensAPI/tokens_DshLoopGuard_code.git",
      "commit": "a4abda43136185aaa8dabf0c15557a47fe717949",
      "package": "@tokens/dsh-loop-guard",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/schemastery": "^3.18.5"
      }
    }
  ]
}
