      "package": "dsh-tokensapi-ui",
      "version": "0.2.22",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "artifact": {
        "type": "npm-tgz",
        "url": "https://github.com/TokensAPI/dsh-tokensapi-ui/releases/download/v0.2.22/dsh-tokensapi-ui-0.2.22.tgz",
