{
  "schemaVersion": 1,
  "product": {
    "name": "TokensHarness",
    "appId": "com.tokensapi.tokensharness",
    "version": "0.1.9"
  },
  "desktop": {
    "path": "desktop",
    "repository": "https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "commit": "8734c2cd21db2b31e670c24d9361acdaf14b7e3c",
    "deepseekHarnessCommit": "47f943859bef60e4160492346772ded9b24f765a"
  },
  "plugins": [
    {
      "id": "tokens-version-updates",
      "path": "plugins/tokens_DshVersionUpdates_code",
      "repository": "https://github.com/sobermh/tokens_DshVersionUpdates_code.git",
      "commit": "7d112a198858e140a9bd6f88b56e550059fba605",
      "package": "@tokens/dsh-version-updates",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
        "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "tokens-model-manager",
      "path": "plugins/tokens_DshModelManager_code",
      "repository": "https://github.com/TokensAPI/tokens_DshModelManager_code.git",
      "commit": "c70c01010d4f2eda7ca4870e52f50a9e1c0d37d8",
      "package": "@tokens/dsh-model-manager",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "commander": "^13.1.0",
        "undici": "^8.10.0"
      }
    },
    {
      "id": "tokens-feishu-connect",
      "path": "plugins/tokens_DshFeishuConnect_code",
      "repository": "https://github.com/sobermh/tokens_DshFeishuConnect_code.git",
      "commit": "028fd7636a33e7a679ad48f7edeb79f7ab2cfbff",
      "sourcePackage": "@tokens/feishu",
      "package": "@tokens/dsh-feishu-connect",
      "version": "0.1.3",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeBuild": {
        "type": "typescript",
        "entry": "src/index.ts",
        "output": "dist/index.js",
        "files": [
          "dist",
          "cordis.patch.yml"
        ]
      },
      "runtimeDependencies": {
        "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
        "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "dsh-tokensapi-ui",
      "path": "plugins/dsh-tokensapi-ui",
      "repository": "https://github.com/TokensAPI/dsh-tokensapi-ui.git",
      "commit": "d2e9bf351607105dba65d8348d728768c03ffd35",
      "package": "dsh-tokensapi-ui",
      "version": "0.1.0",
      "enabledByDefault": false,
      "patch": "cordis.patch.yml",
      "artifact": {
        "type": "npm-tgz",
        "url": "https://github.com/TokensAPI/dsh-tokensapi-ui/releases/download/v0.1.0/dsh-tokensapi-ui-0.1.0.tgz",
        "sha256": "5b982ed340971f4f8eef860274f598ee16cc9e974c81f30f68c8d1c644ba0f2b"
      },
      "runtimeDependencies": {}
    }
  ]
}
