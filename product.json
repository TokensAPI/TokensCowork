{
  "schemaVersion": 1,
  "product": {
    "name": "TokensCowork",
    "appId": "com.tokensapi.tokenscowork",
    "windowsInstallerGuid": "c934e938-5a76-57ee-b6d0-af6fb8157615",
    "repository": "TokensAPI/TokensCowork",
    "legacyNames": [
      "TokensHarness"
    ],
    "version": "0.3.15"
  },
  "desktop": {
    "path": "desktop",
    "repository": "https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "commit": "d457d790295e727bbb1fc20e398da602f521fd64",
    "deepseekHarnessCommit": "141eb6fef83422698aef7a981029e843e8161534"
  },
  "plugins": [
    {
      "id": "tokens-version-updates",
      "displayName": "TokensCowork 更新",
      "description": "从 TokensCowork GitHub Release 检查并下载产品更新，替代官方 DSH 更新入口。",
      "path": "plugins/tokens_DshVersionUpdates_code",
      "repository": "https://github.com/sobermh/tokens_DshVersionUpdates_code.git",
      "commit": "90251f448dbd302e68c464d7528848ada7a77e1a",
      "package": "@tokens/dsh-version-updates",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.8",
        "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "tokens-connect",
      "displayName": "连接中心",
      "description": "统一管理九种 IM 机器人与飞书个人账号授权，并接入本机 TokensCowork。",
      "path": "plugins/tokens_DshConnect_code",
      "repository": "https://github.com/sobermh/tokens_DshConnect_code.git",
      "commit": "a18d23ccddd1ddb53b8b5c095d72db1dc6491fb6",
      "package": "@tokens/dsh-connect",
      "version": "2.4.4",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeBuild": {
        "script": "build",
        "outputs": [
          "lib/index.js",
          "lib/client.js"
        ]
      },
      "runtimeDependencies": {
        "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
        "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
      }
    },
    {
      "id": "dsh-tokensapi-ui",
      "displayName": "Tokens Cowork UI",
      "description": "为 Tokens Cowork 提供品牌视觉、主题皮肤、技能入口和侧栏界面扩展。",
      "path": "plugins/dsh-tokensapi-ui",
      "repository": "https://github.com/TokensAPI/dsh-tokensapi-ui.git",
      "commit": "32fafd9e4e2b4ee20d07d0aa29407b69c93fe929",
      "package": "dsh-tokensapi-ui",
      "version": "0.2.11",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "artifact": {
        "type": "npm-tgz",
        "url": "https://github.com/TokensAPI/dsh-tokensapi-ui/releases/download/v0.2.11/dsh-tokensapi-ui-0.2.11.tgz",
        "sha256": "9c5d8c97e4d48ea31bd7736099beffc87c52b8b9e821c19952b7ad02afce6764"
      },
      "runtimeDependencies": {}
    },
    {
      "id": "tokens-model-manager",
      "displayName": "TokensAPI 模型",
      "description": "统一管理 TokensAPI API Key、主模型与文本视觉桥接，并同步当前会话模型。",
      "path": "plugins/tokens_DshModelManager_code",
      "repository": "https://github.com/TokensAPI/tokens_DshModelManager_code.git",
      "commit": "b27ccf880147f13e3bd63214f61b8a1b949449e2",
      "package": "@tokens/dsh-model-manager",
      "version": "0.2.13",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-at-file",
      "displayName": "本地文件引用",
      "description": "支持选择或拖入本地文件，并将文件路径交给 Harness 使用当前会话工具读取。",
      "path": "plugins/tokens_DshAtFile_code",
      "repository": "https://github.com/TokensAPI/tokens_DshAtFile_code.git",
      "commit": "f068fb9a043188c92f9868f1d8643cee486cd123",
      "package": "@tokens/dsh-at-file",
      "version": "0.1.1",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml"
    },
    {
      "id": "tokens-dsh-web-search",
      "displayName": "联网搜索",
      "description": "为原生 web_search 提供免额外 API Key 的多引擎联网搜索与自动回退。",
      "path": "plugins/tokens_DshWebSearch_code",
      "repository": "https://github.com/sobermh/tokens_DshWebSearch_code.git",
      "commit": "277a7a4fb7da36131487efb53b207bbe1afab5a2",
      "package": "tokens-dsh-web-search",
      "version": "0.1.0",
      "enabledByDefault": true,
      "patch": "cordis.patch.yml",
      "runtimeDependencies": {
        "@deepseek-ai/schemastery": "^3.18.1"
      }
    },
    {
      "id": "tokens-browser-use",
      "displayName": "浏览器操作",
      "description": "桥接 Playwright MCP，让模型驱动可见浏览器完成网页操作，带可视光标与坐标模式。",
      "path": "plugins/tokens_DshBrowserUse_code",
      "repository": "https://github.com/TokensAPI/tokens_DshBrowserUse_code.git",
      "commit": "d9d089b84dc276c19e76b1d1cf9d107e9391a687",
      "package": "@tokensapi/dsh-browser-use",
      "version": "0.1.0",
      "enabledByDefault": false,
      "npmInstall": true,
      "patch": "cordis.patch.yml"
    }
  ]
}
